generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  password      String?
  name          String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  emailVerified DateTime?      @map("email_verified")
  image         String?
  accounts      Account[]
  healthLogs    HealthLog[]
  sessions      Session[]
  userSettings  UserSettings?
  userGameStats UserGameStats?
  checkupReminders CheckupReminder[]
  userPet       UserPet?
  userPetInventory UserPetInventory[]

  @@map("users")
}

model Account {
  id                String @id @default(cuid())
  userId            String @map("user_id")
  type              String
  provider          String
  providerAccountId String @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique @map("user_id")
  modeIbd                 Boolean  @default(true) @map("mode_ibd")
  modeAlcohol             Boolean  @default(false) @map("mode_alcohol")
  modeMental              Boolean  @default(false) @map("mode_mental")
  modeDiet                Boolean  @default(false) @map("mode_diet")
  medicalHistory          String?  @map("medical_history")
  currentMedications      String?  @map("current_medications")
  medicationReminderTimes String?  @map("medication_reminder_times")
  gender                  String?  @default("unspecified")
  aiPersonality           String?  @default("tsundere") @map("ai_personality")
  profileName             String?  @map("profile_name")
  birthDate               String?  @map("birth_date")
  height                  Float?   @map("height")
  weight                  Float?   @map("weight")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserGameStats {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  totalPoints    Int      @default(0) @map("total_points")
  currentStreak  Int      @default(0) @map("current_streak")
  longestStreak  Int      @default(0) @map("longest_streak")
  lastRecordDate String?  @map("last_record_date")
  earnedBadges   Json?    @map("earned_badges")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_game_stats")
}

model CheckupReminder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  dueDate   String   @map("due_date")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("checkup_reminders")
}

model UserPet {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  petName          String    @default("ぽっち") @map("pet_name")
  petSpecies       String    @default("cat") @map("pet_species")
  happiness        Int       @default(50) @map("happiness")
  lastFedAt        DateTime? @map("last_fed_at")
  currentOutfitId  String?   @map("current_outfit_id")
  level            Int       @default(1) @map("level")
  expPoints        Int       @default(0) @map("exp_points")
  adoptedAt        DateTime? @map("adopted_at")
  feedCount        Int       @default(0) @map("feed_count")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_pets")
}

model UserPetInventory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("user_pet_inventory")
}

model HealthLog {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  date            String
  memo            String?
  medicationTaken Boolean  @default(false) @map("medication_taken")
  generalMood     Int?     @map("general_mood")
  mealDescription String?  @map("meal_description")
  periodStatus    String?  @map("period_status")
  aiComment       String?  @map("ai_comment")
  painLevel       Int?     @map("pain_level")
  stoolType       String?  @map("stool_type")
  alcoholAmount   Int      @default(0) @map("alcohol_amount")
  alcoholPercent  Int?     @map("alcohol_percent")
  alcoholType     String?  @map("alcohol_type")
  stressLevel     Int?     @map("stress_level")
  spending        Int?
  weight          Float?
  bodyFat         Float?   @map("body_fat")
  calories        Int?
  protein         Float?
  steps           Int?
  exerciseMinutes Int?     @map("exercise_minutes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  sleepQuality    String?  @map("sleep_quality")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("health_logs")
}
