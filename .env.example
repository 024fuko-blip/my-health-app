# ===========================================
# 環境変数リファレンス
# 本ファイルを .env.local にコピーして値を設定してください
# 本番: Secret Manager から取得（シークレット名は変数名と同一）
# ===========================================

# ----- 必須 -----
AUTH_SECRET=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=

# ----- AI -----
OPENAI_API_KEY=

# ----- LINE 連携 -----
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 友だち追加用（いずれか）
LINE_BOT_BASIC_ID=
LINE_ADD_FRIEND_URL=

# ----- プッシュ通知 -----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# ----- オプション -----
# Secret Manager を無効化（ローカルで process.env のみ使用）
# USE_SECRET_MANAGER=false
# GCP プロジェクトID（未設定時はメタデータサーバーから取得）
# GOOGLE_CLOUD_PROJECT=
